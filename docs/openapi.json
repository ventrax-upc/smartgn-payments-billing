  "components": {
    "schemas": {
      "Visit": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "visitId": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "meterId": {
            "type": "string",
            "format": "uuid"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "cost": {
            "type": "number",
            "minimum": 0.0
          }
        },
        "required": [
          "accountId",
          "completedAt",
          "cost",
          "eventId",
          "meterId",
          "visitId"
        ]
      },
      "Confirmation": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "providerReference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "orderId",
          "providerReference"
        ]
      },
      "Fixture": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "minimum": 0.0
          }
        },
        "required": [
          "amount",
          "orderId",
          "reference",
          "status"
        ]
      },
      "Pro": {
        "type": "object",
        "properties": {
          "paymentMethodId": {
            "type": "string",
            "format": "uuid"
          },
          "autoRenew": {
            "type": "boolean"
          }
        },
        "required": [
          "paymentMethodId"
        ]
      },
      "Card": {
        "type": "object",
        "properties": {
          "providerToken": {
            "type": "string",
            "pattern": "test_[a-zA-Z0-9_-]{16,160}"
          },
          "brand": {
            "type": "string",
            "maxLength": 40,
            "minLength": 0
          },
          "lastFour": {
            "type": "string",
            "pattern": "[0-9]{4}"
          }
        },
        "required": [
          "brand",
          "lastFour",
          "providerToken"
        ]
      },
      "Checkout": {
        "type": "object",
        "properties": {
          "installationId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "firstName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "firstName",
          "installationId",
          "lastName"
        ]
      },
      "Renewal": {
        "type": "object",
        "properties": {
          "autoRenew": {
            "type": "boolean"
          }
        }
      }
    }
  }
}